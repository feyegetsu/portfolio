# Обязательно: без этих двух переменных API не запустится
# Ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=замените-на-длинную-случайную-строку
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=замените-на-надёжный-пароль
CORS_ORIGINS=https://feyegetsu.github.io,http://localhost:8000
TOKEN_TTL_MINUTES=720
RATE_LIMIT=20
RATE_WINDOW_SECONDS=600
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Адрес обратного прокси (nginx), которому можно доверять заголовок X-Forwarded-For
FORWARDED_ALLOW_IPS=127.0.0.1
