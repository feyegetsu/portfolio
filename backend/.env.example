# Обязательно: без этих двух переменных API не запустится
# Ключ: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=замените-на-длинную-случайную-строку
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=замените-на-надёжный-пароль
# Домены сайтов, которым можно вызывать API. Пусто — https://feyegetsu.github.io (и localhost:8000 при ENV=development).
# Для локальной разработки через docker compose допишите http://localhost:8000
CORS_ORIGINS=https://feyegetsu.github.io
TOKEN_TTL_MINUTES=120
RATE_LIMIT=20
# Общий счётчик лимитов для нескольких копий API; пусто — в памяти процесса
REDIS_URL=
RATE_WINDOW_SECONDS=600
LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Неудачные входы на один аккаунт со всех IP и с одного IP на любые e-mail
LOGIN_ACCOUNT_ATTEMPTS=20
LOGIN_ACCOUNT_WINDOW_SECONDS=3600
LOGIN_IP_ATTEMPTS=50
LOGIN_IP_WINDOW_SECONDS=900
# Сколько доверенных прокси (nginx, балансировщик) стоит перед API. 0 — X-Forwarded-For игнорируется
TRUSTED_PROXY_HOPS=0
